# ── Telegram (必填) ─────────────────────────────────────────────
API_ID=your_api_id
API_HASH=your_api_hash
PHONE=+1234567890

# ── 路径 ────────────────────────────────────────────────────────
# 【推荐】只填 DATA_ROOT：程序自动在其下创建 telegramDMZ/{download,move,unzip}
#   三个模块目录自动联动：downloader 下载到 download/ → mover 搬到 move/
#   （move/ 同时是 unzipper 的监听目录）→ 解压输出到 unzip/，不会改漏。
#   各平台示例：
#     Linux / macOS 移动硬盘:  DATA_ROOT=/media/usb1  或  /Volumes/MyDisk
#     Windows WSL（E: 盘）:    DATA_ROOT=/mnt/e
#     Docker:                  DATA_ROOT=/data（容器内固定；宿主机路径在 compose 里映射）
#   留空 = ~/TGhelperFileSystem（2026-11-13 起；旧版默认是 ~/HydenFileSystem，已存在的话会继续沿用）
DATA_ROOT=
# 手动搬运（mover）只许搬到数据目录之下。要搬到别的地方，把那些目录写在这里（逗号分隔的绝对路径）
MOVE_ALLOWED_ROOTS=
# 【Docker 专用】宿主机数据根目录（docker compose 读取；容器内 DATA_ROOT 固定 /data）
#   Windows: HOST_DATA_ROOT=E:/          macOS: HOST_DATA_ROOT=/Volumes/MyDisk
#   Linux:   HOST_DATA_ROOT=/media/usb1  留空默认 ./data
# HOST_DATA_ROOT=
# 【Docker 专用】以哪个用户运行（可选）。不设 = root，下载出来的文件属主是 root。
#   Linux 上建议设成你自己的 uid / gid（终端里 `id -u` / `id -g` 查），并保证它对 HOST_DATA_ROOT 有写权限
# PUID=1000
# PGID=1000
# 时区（日志时间、按天切分日志都用它）。不设 = UTC。例：Asia/Shanghai、America/Los_Angeles
# TZ=UTC
# 【Docker 专用】宿主端口被占用时改宿主侧映射（容器内端口固定不变）
# HOST_DASHBOARD_PORT=8090
# HOST_WEB_PORT=8091
# HOST_MOVER_PORT=8092
# HOST_UNZIPPER_PORT=8093
# 【高级】逐项覆盖（设了就优先于 DATA_ROOT 派生；⚠️ 三个目录必须互不重叠！）
# DOWNLOAD_DIR=./downloads
# WATCH_PATH=./watch        # unzipper 监听目录 = mover 搬运目标，必须与 DOWNLOAD_DIR 不同
# OUTPUT_PATH=./extracted   # 解压输出目录，必须独立

# ── 安全 ────────────────────────────────────────────────────────
# 留空则不启用 API 鉴权，公网部署强烈建议设置
API_KEY=
# 监听地址：默认仅本机可访问。改成 0.0.0.0 / 局域网 IP 时必须设 API_KEY，否则拒绝启动；
# 确定是可信内网、就是不想设密码 → 加一行 ALLOW_NO_API_KEY=1。
# （Docker 部署不看这一项：容器里固定 0.0.0.0，谁能访问由 docker-compose 的 ports 决定）
LISTEN_HOST=127.0.0.1
# 解压密码列表，逗号分隔，密码本身不能含逗号
PASSWORDS=

# ── 性能 ────────────────────────────────────────────────────────
# 连续多少秒没进度就判卡死、重来。⚠️ 别设 60：会和 Telegram 限流等待（60 秒）撞车，大文件永远下不完
DOWNLOAD_TIMEOUT=180
MAX_TOTAL_CONNECTIONS=20
CHUNK_SIZE=1048576
MOVER_MAX_CONCURRENT=3
MAX_CONCURRENT_TASKS=3
# mover 历史记录上限（仅裁剪 done/failed，pending/copying 永不裁剪）
MOVER_MAX_HISTORY=500
# 小文件阈值（MB）：低于此值的文件视为小文件，可使用全部连接
SMALL_FILE_THRESHOLD_MB=5
# 始终为小文件硬预留的连接数（即使无小文件等待，大文件也用不到这些连接）
SMALL_FILE_RESERVED_CONNECTIONS=3

# ── 端口 ────────────────────────────────────────────────────────
DASHBOARD_PORT=8090
WEB_PORT=8091
MOVER_PORT=8092
UNZIPPER_PORT=8093

# ── 标志位 ──────────────────────────────────────────────────────
AUTO_MOVE=true
# 重启 / 断电来电后：RESUME = 各个暂停开关恢复成关机前的样子（默认）；
#                    PAUSED = 每次都回到出厂默认（下载监听暂停），离线期间积压太多时用
RESTART_MODE=RESUME
# Docker 部署：容器卡死（进程活着但健康检查连续失败）时由 control 服务自动重启。
# 同一服务 10 分钟内不重复重启，1 小时超过 3 次就停手并通知（ADMIN_CHAT_ID）。原生部署忽略这项
# AUTOHEAL=true

# ── 历史记录 ────────────────────────────────────────────────────
# 已完成下载历史上限（硬上限，超过裁剪最旧）。5MB ~ 5000 条。
MAX_HISTORY=5000

# ── 日志 ────────────────────────────────────────────────────────
# 日志级别：DEBUG / INFO（默认）/ WARNING / ERROR
LOG_LEVEL=INFO
# 日志文件（logs/app.log）按天 rotate 后保留几天（默认 14；旧文件 gzip 压缩）
# LOG_KEEP_DAYS=14
# 历史下载 job done/error/cancelled 状态超过 N 天自动删（默认 30）
# HISTORY_JOB_KEEP_DAYS=30

# ── 崩溃通知（可选）─────────────────────────────────────────────
# 填写后启用 Telegram 通知；同时填 ADMIN_CHAT_ID。两种发送方式：
#   1. BOT_TOKEN（推荐）：注册一个 Telegram Bot（@BotFather）获取 token
#   2. 不填 BOT_TOKEN：仅 bot.py 进程能发（复用已登录的 user session）
#      mover/dashboard 单独进程崩溃时无法发送通知
# 留空则只依赖 systemd Restart=on-failure 自动重启，不发外部通知。
# ADMIN_CHAT_ID=你的TelegramUserID
# BOT_TOKEN=123456:ABC-DEF...
